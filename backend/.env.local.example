# 로컬 Flask + Firestore/Auth Emulator
# 복사: copy backend\.env.local.example backend\.env

USE_FIREBASE_EMULATOR=true
FIREBASE_PROJECT_ID=wiz-coco
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

COST_SAVER_MODE=true
FLASK_ENV=development
SECRET_KEY=local-dev-secret-change-me

PUBLIC_SITE_URL=http://localhost:3000

# Emulator만 쓸 때 서비스 계정 JSON 없어도 됨 (USE_FIREBASE_EMULATOR=true)
# prod 데이터가 필요하면 FIREBASE_CREDENTIALS_PATH=../Firebase_GitHub/....json

SMTP_HOST=
RATE_LIMIT_ACCESS_CODE=0
RATE_LIMIT_PASSWORD_API=0
